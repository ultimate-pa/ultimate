// Simple test for computation of Owicki-Gries annotation where the error may occur, that an error place falsly gets extended into the initial territory
// -----------------------------------------------------------------------------------------------------------------------------------------------------

//@ variables (x Int) (y Int)

//@ semantics [1] {x} (= x 1)
//@ semantics [2] {y} (= y 1)
//@ semantics [3] { } (distinct x 1)
//@ semantics [4] { } (distinct y 1)

PetriNet program = (
  alphabet    = { "[1]" "[2]" "[3]" "[4]" },
  places      = { "l0" "l1" "l2" "e" },
  transitions = {
    ({ "l0" } "[1]" { "l1" })
    ({ "l0" } "[2]" { "l2" })
    ({ "l1" } "[3]" { "e" })
    ({ "l2" } "[4]" { "e" })
  },
  initialMarking = { "l0" },
  acceptingPlaces = { "e" }
);

FiniteAutomaton proof1 = (
     alphabet      = { "[1]" "[2]" "[3]" "[4]" },
     states        = { "true" "(= x 1)" "false" },
     initialStates = { "true" },
     finalStates   = { "false" },
     transitions   = {
         ("true"     "[1]" "(= x 1)")
         ("true"     "[2]" "true")
         ("true"     "[3]" "true")
         ("true"     "[4]" "true")
         ("(= x 1)" "[3]" "false")
     }
);

FiniteAutomaton proof2 = (
     alphabet      = { "[1]" "[2]" "[3]" "[4]" },
     states        = { "true" "(= y 1)" "false" },
     initialStates = { "true" },
     finalStates   = { "false" },
     transitions   = {
         ("true"     "[2]" "(= y 1)")
         ("true"     "[1]" "true")
         ("true"     "[3]" "true")
         ("true"     "[4]" "true")
         ("(= y 1)" "[4]" "false")
     }
);
