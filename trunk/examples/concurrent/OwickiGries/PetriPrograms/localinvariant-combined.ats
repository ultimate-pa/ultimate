// Simple test for computation of Owicki-Gries annotation
// ------------------------------------------------------
// The idea is that the invariant (= |main.x| 0) needed to prove unreachability
// of the main thread's error location should be "transported" only along the
// main thread. Conversely, the invariant (>= y 0) needed to prove unreachability
// of the forked thread's error location should be "transported" only along the
// forked thread.

//@ variables (y Int) (|main.x| Int)

//@ semantics [0] {main.x,y} (and (= |main.x| 0) (= y 0))
//@ semantics [1] { } true
//@ semantics [2] {y} (= y 7)
//@ semantics [3] { } true
//@ semantics [4] { } (distinct |main.x| 0)
//@ semantics [5] {y} (= y (+ |old(y)| 1))
//@ semantics [6] {y} (= y (+ |old(y)| 2))
//@ semantics [7] { } (< y 0)

PetriNet program = (
  alphabet    = { "[0]" "[1]" "[2]" "[3]" "[4]" "[5]" "[6]" "[7]" },
  places      = { "main.l0" "main.l1" "main.l2" "main.l3" "main.l4" "main.e" "t.l1" "t.l2" "t.l3" "t.e" },
  transitions = {
    ({ "main.l0" } "[0]" { "main.l1" })
    ({ "main.l1" } "[1]" { "main.l2" "t.l1" })
    ({ "main.l2" } "[2]" { "main.l3" })
    ({ "main.l3" "t.l3" } "[3]" { "main.l4" })
    ({ "main.l4" } "[4]" { "main.e" })
    ({ "t.l1" } "[5]" { "t.l2" })
    ({ "t.l2" } "[6]" { "t.l3" })
    ({ "t.l3" } "[7]" { "t.e" })
  },
  initialMarking = { "main.l0" },
  acceptingPlaces = { "main.e" "t.e" }
);

FiniteAutomaton proof1 = (
     alphabet      = { "[0]" "[1]" "[2]" "[3]" "[4]" "[5]" "[6]" "[7]" },
     states        = { "true" "(= |main.x| 0)" "false" },
     initialStates = { "true" },
     finalStates   = { "false" },
     transitions   = {
       ("true" "[0]" "(= |main.x| 0)")

       ("(= |main.x| 0)" "[1]" "(= |main.x| 0)")
       ("(= |main.x| 0)" "[2]" "(= |main.x| 0)")
       ("(= |main.x| 0)" "[3]" "(= |main.x| 0)")
       ("(= |main.x| 0)" "[5]" "(= |main.x| 0)")
       ("(= |main.x| 0)" "[6]" "(= |main.x| 0)")
       ("(= |main.x| 0)" "[7]" "(= |main.x| 0)")

       ("(= |main.x| 0)" "[4]" "false")

       ("false" "[0]" "false")
       ("false" "[1]" "false")
       ("false" "[2]" "false")
       ("false" "[3]" "false")
       ("false" "[4]" "false")
       ("false" "[5]" "false")
       ("false" "[6]" "false")
       ("false" "[7]" "false")
     }
);

FiniteAutomaton proof2 = (
     alphabet      = { "[0]" "[1]" "[2]" "[3]" "[4]" "[5]" "[6]" "[7]" },
     states        = { "true" "(>= y 0)" "false" },
     initialStates = { "true" },
     finalStates   = { "false" },
     transitions   = {
       ("true" "[0]" "(>= y 0)")

       ("(>= y 0)" "[1]" "(>= y 0)")
       ("(>= y 0)" "[2]" "(>= y 0)")
       ("(>= y 0)" "[5]" "(>= y 0)")
       ("(>= y 0)" "[6]" "(>= y 0)")

       ("(>= y 0)" "[7]" "false")

       ("false" "[0]" "false")
       ("false" "[1]" "false")
       ("false" "[2]" "false")
       ("false" "[3]" "false")
       ("false" "[4]" "false")
       ("false" "[5]" "false")
       ("false" "[6]" "false")
       ("false" "[7]" "false")
     }
);


