<project name="llvmir-parser" default="generate" basedir=".">
	<property name="pluginDir" location="${basedir}" />
	<property name="workspaceDir" location="${pluginDir}/.." />
	<property name="antlrBinary" location="${pluginDir}/lib/antlr-4.13.2-complete.jar" />
	<property name="parserCodeDir" location="${pluginDir}/src/de/uni_freiburg/informatik/ultimate/lib/llvmir" />

	<description>Build automation for LLVM IR parser</description>

	<target name="generate" depends="generate-parser" />
	<target name="clean" depends="clean-parser" />

	<echo level="info">Library-Llvmir: pluginDir     is ${pluginDir}</echo>
	<echo level="info">Library-Llvmir: workspaceDir  is ${workspaceDir}</echo>
	<echo level="info">Library-Llvmir: antlrBinary   is ${antlrBinary}</echo>
	<echo level="info">Library-Llvmir: parserCodeDir is ${parserCodeDir}</echo>

	<target name="generate-parser">
		<!-- Generate LLVM IR parser with the parser generator ANTLR -->
		<java jar="${antlrBinary}" dir="${parserCodeDir}" fork="true" failonerror="true">
			<arg value="-listener" />
			<arg value="-visitor" />
			<arg value="-package" />
			<arg value="de.uni_freiburg.informatik.ultimate.lib.llvmir" />
			<arg value="-o" />
			<arg value="${parserCodeDir}" />
			<arg value="LLVMIR.g4" />
		</java>
	</target>

	<target name="clean-parser">
		<!-- Clean generated LLVM IR parser files -->
		<delete verbose="true" failonerror="false">
			<fileset dir="${parserCodeDir}" defaultexcludes="false">
				<include name="LLVMIRBaseListener.java" />
				<include name="LLVMIRBaseVisitor.java" />
				<include name="LLVMIR.interp" />
				<include name="LLVMIRLexer.interp" />
				<include name="LLVMIRLexer.java" />
				<include name="LLVMIRLexer.tokens" />
				<include name="LLVMIRListener.java" />
				<include name="LLVMIRParser.java" />
				<include name="LLVMIR.tokens" />
				<include name="LLVMIRVisitor.java" />
			</fileset>
		</delete>
	</target>
</project>
