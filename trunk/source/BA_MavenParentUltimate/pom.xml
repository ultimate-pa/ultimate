			Use this profile to run sonar analysis. You need to specify 
			-Dsonar.host.url=<url> 
			-Dsonar.token='<token>' 
			as CLI arguments (or in some other way).
			See https://docs.sonarsource.com/sonarqube/9.9/analyzing-source-code/scanners/sonarscanner-for-maven/
			-->
			<id>sonar</id>

			<build>
				<plugins>
					<plugin>
						<groupId>org.eclipse.tycho</groupId>
						<artifactId>tycho-surefire-plugin</artifactId>
						<version>${tycho-version}</version>
						<configuration>
							<skipTests>true</skipTests>
						</configuration>
