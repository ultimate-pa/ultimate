<project name="acsl-parser" default="generate" basedir=".">
	<property name="pluginDir" location="${basedir}" />
	<property name="workspaceDir" location="${pluginDir}/.." />
	<property name="astbuilderDir" location="${workspaceDir}/ASTBuilder/bin" />
	<property name="cupDir" location="${workspaceDir}/JavaCup/bin" />
	<property name="astCodeDir" location="${basedir}/src/de/uni_freiburg/informatik/ultimate/civlizer/model" />

	<description>Build automation for Civlizer</description>

	<target name="generate" depends="generate-ast" />
	<target name="clean" depends="clean-ast" />

	<echo level="info">Civlizer: pluginDir     is ${pluginDir}</echo>
	<echo level="info">Civlizer: workspaceDir  is ${workspaceDir}</echo>
	<echo level="info">Civlizer: astbuilderDir is ${astbuilderDir}</echo>
	<echo level="info">Civlizer: cupDir        is ${cupDir}</echo>
	<echo level="info">Civlizer: astCodeDir    is ${astCodeDir}</echo>

	<target name="generate-ast">
		<!-- Generate Civl model AST with the AST builder -->
		<java classname="de.uni_freiburg.informatik.ultimate.astbuilder.Main" classpath="${astbuilderDir}:${cupDir}" dir="${astCodeDir}" fork="true" failonerror="true">
			<arg value="civl.ast" />
		</java>
	</target>

	<target name="clean-ast">
		<!-- Clean generated Civl model AST files -->
		<delete verbose="true" failonerror="false">
			<fileset dir="${astCodeDir}" includes="*.java" defaultexcludes="false" />
		</delete>
	</target>
</project>
