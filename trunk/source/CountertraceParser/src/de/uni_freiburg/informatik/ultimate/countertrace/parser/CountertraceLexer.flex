/* Countertrace lexer */
package de.uni_freiburg.informatik.ultimate.countertrace.parser;
import com.github.jhoenicke.javacup.runtime.Symbol;
import com.github.jhoenicke.javacup.runtime.SimpleSymbolFactory;

/**
 * This is an autogenerated lexer for Ultimate's countertrace format.
 * It is generated from CountertraceLexer.flex by JFlex.
 *
 * It tokenizes the DC-phase notation for countertrace formulae,
 * using Unicode notation only.
 */
%%

%class CtLexer
%unicode
%ignorecase
%implements com.github.jhoenicke.javacup.runtime.Scanner
%type com.github.jhoenicke.javacup.runtime.Symbol
%function next_token
%line
%column
%public

%{
  private SimpleSymbolFactory symFactory = new SimpleSymbolFactory();

  private Symbol symbol(int type) {
    return symFactory.newSymbol(yytext(), type, yyline+1, yycolumn, yyline+1, yycolumn+yylength());
  }
  private Symbol symbol(int type, Object value) {
    return symFactory.newSymbol(yytext(), type, yyline+1, yycolumn, yyline+1, yycolumn+yylength(), value);
  }
%}

LineTerminator = \r|\n|\r\n
InputCharacter = [^\r\n]
WhiteSpace     = {LineTerminator} | [ \t\f]

Comment = {TraditionalComment} | {EndOfLineComment}
TraditionalComment = "/*" ~"*/"
EndOfLineComment = "//" {InputCharacter}* {LineTerminator}?

BoogieLetter = [:letter:] | ['~#$\^_?\\]
BoogieLetterDigit = {BoogieLetter} | [:digit:]
Identifier = {BoogieLetter} {BoogieLetterDigit}*

DecIntegerLiteral = 0 | [1-9][0-9]*
RealIntegerLiteral = {DecIntegerLiteral} "." [0-9]+

/* Unicode operator aliases */
UAndChar = \u2227
UOrChar = \u2228
UNotChar = \u00ac
UImplyChar = \u21d2
ULeqChar = \u2264
UGeqChar = \u2265
UNeqChar = \u2260
UCEIL = \u2308
RCEIL = \u2309
UEllChar = \u2113
USubZero = \u2080

%%

<YYINITIAL> {
  /* Phase delimiters: ⌈ ... ⌉ (Unicode only) */
  {UCEIL}            { return symbol(CtSymbols.LCEIL); }
  {RCEIL}            { return symbol(CtSymbols.RCEIL); }

  /* Phase separator */
  ";"                { return symbol(CtSymbols.SEMI); }

  /* Bound conjunction: ∧ (Unicode only) */
  {UAndChar}         { return symbol(CtSymbols.CAND); }

  /* Duration variable ℓ (Unicode only) */
  {UEllChar}         { return symbol(CtSymbols.ELL); }

  /* Comparison operators with allowEmpty subscript ₀ (Unicode only) */
  "<" {USubZero}        { return symbol(CtSymbols.LE_SUBZERO); }
  {ULeqChar} {USubZero} { return symbol(CtSymbols.LTEQ_SUBZERO); }
  {UGeqChar} {USubZero} { return symbol(CtSymbols.GTEQ_SUBZERO); }
  ">" {USubZero}        { return symbol(CtSymbols.GREATER_SUBZERO); }

  /* Regular comparison operators (Unicode + ASCII for Boogie expressions) */
  {ULeqChar}         { return symbol(CtSymbols.LTEQ); }
  "<="               { return symbol(CtSymbols.LTEQ); }
  {UGeqChar}         { return symbol(CtSymbols.GTEQ); }
  ">="               { return symbol(CtSymbols.GTEQ); }
  {UNeqChar}         { return symbol(CtSymbols.NEQ); }
  "!="               { return symbol(CtSymbols.NEQ); }
  "=="               { return symbol(CtSymbols.EQ); }
  "<"                { return symbol(CtSymbols.LE); }
  ">"                { return symbol(CtSymbols.GREATER); }

  /* Arithmetic operators */
  "+"                { return symbol(CtSymbols.PLUS); }
  "-"                { return symbol(CtSymbols.MINUS); }
  "*"                { return symbol(CtSymbols.TIMES); }
  "/"                { return symbol(CtSymbols.DIVIDE); }
  "%"                { return symbol(CtSymbols.MOD); }

  /* Logical operators (for expressions inside invariants) */
  "!"                { return symbol(CtSymbols.LNOT); }
  {UNotChar}         { return symbol(CtSymbols.LNOT); }
  "&&"               { return symbol(CtSymbols.LAND); }
  "||"               { return symbol(CtSymbols.LOR); }
  {UOrChar}          { return symbol(CtSymbols.LOR); }
  "==>"              { return symbol(CtSymbols.LIMPLIES); }
  {UImplyChar}       { return symbol(CtSymbols.LIMPLIES); }

  /* Parentheses, comma, dot, colon */
  "("                { return symbol(CtSymbols.LPAR); }
  ")"                { return symbol(CtSymbols.RPAR); }
  ","                { return symbol(CtSymbols.COMMA); }
  "."                { return symbol(CtSymbols.DOT); }
  ":"                { return symbol(CtSymbols.COLON); }

  /* Boolean literals */
  "true"             { return symbol(CtSymbols.TRUE); }
  "false"            { return symbol(CtSymbols.FALSE); }

  /* Declaration keywords (case-insensitive, analogous to .req files) */
  "Input"            { return symbol(CtSymbols.INPUT); }
  "Output"           { return symbol(CtSymbols.OUTPUT); }
  "Internal"         { return symbol(CtSymbols.INTERNAL); }
  "Const"            { return symbol(CtSymbols.CONST); }
  "is"               { return symbol(CtSymbols.IS); }

  /* Identifiers */
  {Identifier}       { return symbol(CtSymbols.ID, yytext().intern()); }

  /* Literals */
  {DecIntegerLiteral}  { return symbol(CtSymbols.NUMBER, yytext().intern()); }
  {RealIntegerLiteral} { return symbol(CtSymbols.REALNUMBER, yytext().intern()); }

  /* Comments */
  {Comment}          { /* ignore */ }

  /* Whitespace */
  {WhiteSpace}       { /* ignore */ }
}

/* error fallback */
.|\n                 { return symbol(CtSymbols.error, yytext()); }

<<EOF>>              { return symbol(CtSymbols.EOF); }
