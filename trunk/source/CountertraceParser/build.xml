<project name="countertrace-parser" default="generate" basedir=".">
	<property name="pluginDir" location="${basedir}" />
	<property name="workspaceDir" location="${pluginDir}/.." />
	<property name="cupDir" location="${workspaceDir}/JavaCup/bin" />
	<property name="flexBinary" location="${workspaceDir}/JavaCup/JFlex.jar" />
	<property name="ctCodeDir" location="${pluginDir}/src/de/uni_freiburg/informatik/ultimate/countertrace/parser" />

	<description>Build automation for Countertrace parser</description>

	<target name="generate" depends="generate-parser" />
	<target name="clean" depends="clean-lexer,clean-parser" />

	<echo level="info">CountertraceParser: pluginDir  is ${pluginDir}</echo>
	<echo level="info">CountertraceParser: workspaceDir is ${workspaceDir}</echo>
	<echo level="info">CountertraceParser: cupDir    is ${cupDir}</echo>
	<echo level="info">CountertraceParser: flexBinary is ${flexBinary}</echo>
	<echo level="info">CountertraceParser: ctCodeDir  is ${ctCodeDir}</echo>

	<target name="generate-lexer">
		<!-- Generate Countertrace lexer with the lexer generator JFlex -->
		<java jar="${flexBinary}" dir="${ctCodeDir}" fork="true" failonerror="true">
			<arg value="CountertraceLexer.flex" />
		</java>
	</target>

	<target name="generate-parser" depends="generate-lexer">
		<!-- Generate Countertrace parser with the parser generator JavaCup -->
		<java classname="com.github.jhoenicke.javacup.Main" classpath="${cupDir}" dir="${ctCodeDir}" fork="true" failonerror="true">
			<arg value="CountertraceParser.cup" />
		</java>
	</target>

	<target name="clean-lexer">
		<!-- Clean generated Countertrace lexer files -->
		<delete verbose="true" failonerror="false">
			<fileset dir="${ctCodeDir}" defaultexcludes="false">
				<include name="CtLexer.java" />
				<include name="CtLexer.java~" />
			</fileset>
		</delete>
	</target>

	<target name="clean-parser">
		<!-- Clean generated Countertrace parser files -->
		<delete verbose="true" failonerror="false">
			<fileset dir="${ctCodeDir}" defaultexcludes="false">
				<include name="CtParser.java" />
				<include name="CtSymbols.java" />
			</fileset>
		</delete>
	</target>
</project>
