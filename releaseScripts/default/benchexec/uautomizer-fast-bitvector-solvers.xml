<?xml version="1.0"?>
<!DOCTYPE benchmark PUBLIC "+//IDN sosy-lab.org//DTD BenchExec benchmark 1.9//EN" "https://www.sosy-lab.org/benchexec/benchmark-2.3.dtd">
<benchmark tool="ultimateautomizer" displayName="UAutomizer" timelimit="120s" hardtimelimit="120s" memlimit="8 GB" cpuCores="2">

  <resultfiles></resultfiles>
  <option name="--full-output"/>
  <option name="--force-no-wrapper"/>
  <option name="--traceabstraction.trace.refinement.strategy">FIXED_PREFERENCES</option>

  <rundefinition name="SMTInterpol">
    <option name="-tc">../../../trunk/examples/toolchains/AutomizerCInline.xml</option>
    <option name="--traceabstraction.smt.solver">Internal_SMTInterpol</option>
  </rundefinition>

  <rundefinition name="Z3">
    <option name="--traceabstraction.smt.solver">External_ModelsAndUnsatCoreMode</option>
    <option name="--traceabstraction.command.for.external.solver">"z3 -smt2 -in SMTLIB2_COMPLIANT=true"</option>
  </rundefinition>

  <rundefinition name="CVC4">
    <option name="--traceabstraction.smt.solver">External_ModelsAndUnsatCoreMode</option>
    <option name="--traceabstraction.command.for.external.solver">"cvc4 --incremental --print-success --lang smt"</option>
  </rundefinition>

  <rundefinition name="CVC5">
    <option name="--traceabstraction.smt.solver">External_ModelsAndUnsatCoreMode</option>
    <option name="--traceabstraction.command.for.external.solver">"cvc5 --incremental --print-success --lang smt"</option>
  </rundefinition>

  <rundefinition name="MathSAT">
    <option name="--traceabstraction.smt.solver">External_ModelsAndUnsatCoreMode</option>
    <option name="--traceabstraction.command.for.external.solver">"mathsat -theory.fp.to_bv_overflow_mode=1 -theory.fp.minmax_zero_mode=4 -theory.bv.div_by_zero_mode=1 -unsat_core_generation=3"</option>
  </rundefinition>

  <rundefinition name="bitwuzla">
    <option name="--traceabstraction.smt.solver">External_ModelsAndUnsatCoreMode</option>
    <option name="--traceabstraction.command.for.external.solver">"bitwuzla"</option>
  </rundefinition>

  <tasks name="ReachSafety32">
    <includesfile>../../../trunk/examples/svcomp/BitVectors.set</includesfile>
    <includesfile>../../../trunk/examples/svcomp/Floats.set</includesfile>
    <includesfile>../../../trunk/examples/svcomp/Hardness.set</includesfile>
    <propertyfile>../../../trunk/examples/svcomp/properties/unreach-call.prp</propertyfile>
    <option name="-s">../../../trunk/examples/settings/default/automizer/svcomp-Reach-32bit-Automizer_Bitvector.epf</option>
  </tasks>

  <tasks name="ReachSafety64">
    <includesfile>../../../trunk/examples/svcomp/SoftwareSystems-DeviceDriversLinux64.set</includesfile>
    <includesfile>../../../trunk/examples/svcomp/SoftwareSystems-AWS-C-Common.set</includesfile>
    <includesfile>../../../trunk/examples/svcomp/Hardware.set</includesfile>
    <propertyfile>../../../trunk/examples/svcomp/properties/unreach-call.prp</propertyfile>
    <option name="-s">../../../trunk/examples/settings/default/automizer/svcomp-Reach-64bit-Automizer_Bitvector.epf</option>
  </tasks>

  <tasks name="MemSafety64">
    <includesfile>../../../trunk/examples/svcomp/SoftwareSystems-DeviceDriversLinux64.set</includesfile>
    <includesfile>../../../trunk/examples/svcomp/Juliet.set</includesfile>
    <propertyfile>../../../trunk/examples/svcomp/properties/valid-memsafety.prp</propertyfile>
    <option name="-s">../../../trunk/examples/settings/default/automizer/svcomp-DerefFreeMemtrack-64bit-Automizer_Bitvector.epf</option>
  </tasks>

  <tasks name="NoOverflow32">
    <includesfile>../../../trunk/examples/svcomp/BitVectors.set</includesfile>
    <propertyfile>../../../trunk/examples/svcomp/properties/no-overflow.prp</propertyfile>
    <option name="-s">../../../trunk/examples/settings/default/automizer/svcomp-Overflow-32bit-Automizer_Bitvector.epf</option>
  </tasks>
</benchmark>
