<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<benchmark tool="ultimateautomizer" memlimit="8GB" timelimit="90" hardtimelimit="90" cpuCores="2">
  <resultfiles></resultfiles>
  <option name="--force-no-wrapper" />
  <option name="-tc">${benchmark_path}/../../../trunk/examples/toolchains/AbstractInterpretationCInline.xml</option>
  <option name="-s">${benchmark_path}/../../../trunk/examples/settings/default/automizer/svcomp-Overflow-32bit-Automizer_Default.epf</option>
  <option name="--abstractinterpretationv2.abstract.domain">OctagonDomain</option>
  <option name="--abstractinterpretationv2.abstract.domain.for.rcfg-of-the-future">PoormanAbstractDomain</option>
  <option name="--abstractinterpretationv2.use.the.rcfg-of-the-future.interface">true</option>
  <option name="--rcfgbuilder.future-live.optimization">false</option>

  <rundefinition name="singleton">
    <option name="--abstractinterpretationv2.location.abstraction.method">"SINGLETON"</option>
  </rundefinition>

  <rundefinition name="split-at-guards">
    <option name="--abstractinterpretationv2.location.abstraction.method">"SPLIT_AT_GUARDS"</option>
  </rundefinition>

  <rundefinition name="split-at-guards-and-writes">
    <option name="--abstractinterpretationv2.location.abstraction.method">"SPLIT_AT_GUARDS_AND_WRITES"</option>
  </rundefinition>

  <rundefinition name="split-at-every-location">
    <option name="--abstractinterpretationv2.location.abstraction.method">"SPLIT_AT_EVERY_LOCATION"</option>
  </rundefinition>

  <tasks name="SVCOMP-Concurrency">
    <includesfile>${benchmark_path}/../../../trunk/examples/svcomp/Concurrency.set</includesfile>
    <!-- Exclude pthread-wmm to speedup evaluation -->
    <exclude>${benchmark_path}/../../../trunk/examples/svcomp/pthread-wmm/*.yml</exclude>
    <propertyfile>${benchmark_path}/../../../trunk/examples/svcomp/properties/no-overflow.prp</propertyfile>
  </tasks>
</benchmark>
