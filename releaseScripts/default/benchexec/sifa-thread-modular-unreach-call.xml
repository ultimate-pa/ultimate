<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<benchmark tool="ultimateautomizer" memlimit="8GB" timelimit="90" hardtimelimit="90" cpuCores="2">
  <resultfiles></resultfiles>
  <option name="--force-no-wrapper" />
  <option name="-tc">${benchmark_path}/../../../trunk/examples/toolchains/SifaCThreadModular.xml</option>
  <option name="-s">${benchmark_path}/../../../trunk/examples/settings/default/automizer/svcomp-Reach-32bit-Automizer_Default.epf</option>

  <!-- Shared baseline: ExplicitValueDomain, PER_ABSTRACT_LOCATION, parallel=4 -->
  <option name="--sifa.abstract.domain">ExplicitValueDomain</option>
  <option name="--sifa.max.parallel.explicit.values">4</option>
  <option name="--sifa.interference.type">PER_ABSTRACT_LOCATION</option>
  <option name="--sifa.join.precision">false</option>
  <option name="--sifa.fluid">SizeLimitFluid</option>

  <rundefinition name="loc-qe">
    <option name="--sifa.interference.applicator">QE</option>
  </rundefinition>

  <rundefinition name="loc-prepost">
    <option name="--sifa.interference.applicator">PREPOST</option>
  </rundefinition>

  <rundefinition name="loc-guarded-overwrite">
    <option name="--sifa.interference.applicator">GUARDED_OVERWRITE</option>
  </rundefinition>

  <rundefinition name="loc-post-state">
    <option name="--sifa.interference.applicator">POST_STATE</option>
  </rundefinition>

  <rundefinition name="thread-qe">
    <option name="--sifa.interference.type">PER_THREAD</option>
    <option name="--sifa.interference.applicator">QE</option>
  </rundefinition>

  <rundefinition name="thread-prepost">
    <option name="--sifa.interference.type">PER_THREAD</option>
    <option name="--sifa.interference.applicator">PREPOST</option>
  </rundefinition>

  <rundefinition name="thread-guarded-overwrite">
    <option name="--sifa.interference.type">PER_THREAD</option>
    <option name="--sifa.interference.applicator">GUARDED_OVERWRITE</option>
  </rundefinition>

  <rundefinition name="thread-post-state">
    <option name="--sifa.interference.type">PER_THREAD</option>
    <option name="--sifa.interference.applicator">POST_STATE</option>
  </rundefinition>

  <tasks name="SVCOMP-Concurrency">
    <includesfile>${benchmark_path}/../../../trunk/examples/svcomp/Concurrency.set</includesfile>
    <!-- Exclude pthread-wmm to speedup evaluation -->
    <exclude>${benchmark_path}/../../../trunk/examples/svcomp/pthread-wmm/*.yml</exclude>
    <propertyfile>${benchmark_path}/../../../trunk/examples/svcomp/properties/unreach-call.prp</propertyfile>
  </tasks>
</benchmark>
