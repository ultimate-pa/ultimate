<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<benchmark tool="ultimateautomizer" memlimit="8GB" timelimit="120" hardtimelimit="130" cpuCores="2">

  <resultfiles></resultfiles>
  <option name="--full-output" />

  <rundefinition name="NoFairness">
    <option name="--buchiautomizer.assuming.strong.fairness">false</option>
  </rundefinition>

  <rundefinition name="FairnessLast">
    <option name="--buchiautomizer.assuming.strong.fairness">true</option>
    <option name="--buchiautomizer.checking.fairness.of.trace.before.termination.of.trace">false</option>
  </rundefinition>

  <rundefinition name="FairnessFirst">
    <option name="--buchiautomizer.assuming.strong.fairness">true</option>
    <option name="--buchiautomizer.checking.fairness.of.trace.before.termination.of.trace">true</option>
  </rundefinition>

  <tasks name="SVCOMP ConcurrencySafety-Main">
    <includesfile>../../../trunk/examples/svcomp/Concurrency.set</includesfile>
    <propertyfile>../../../trunk/examples/svcomp/properties/termination.prp</propertyfile>
  </tasks>
</benchmark>
