<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<benchmark tool="ultimateautomizer" memlimit="8GB" timelimit="90" hardtimelimit="90" cpuCores="2">
  <resultfiles></resultfiles>
  <option name="--force-no-wrapper" />
  <option name="-tc">${benchmark_path}/../../../trunk/examples/toolchains/SifaCThreadModular.xml</option>
  <option name="-s">${benchmark_path}/../../../trunk/examples/settings/default/automizer/svcomp-Overflow-32bit-Automizer_Default.epf</option>
  <option name="--sifa.proof.check">false</option>
  <option name="--sifa.result.print">false</option>

  <rundefinition name="none-UNSOUND-timing-only">
    <option name="--sifa.abstract.domain">ExplicitValueDomain</option>
    <option name="--sifa.interference.applicator">NONE</option>
    <option name="--sifa.max.parallel.explicit.values">1</option>
    <option name="--sifa.join.precision">false</option>
    <option name="--sifa.location.tracking.mode">NONE</option>
    <option name="--sifa.location.abstraction">SINGLETON</option>
  </rundefinition>

  <rundefinition name="explicitvalue-poststate-guard-lockset-publish">
    <option name="--sifa.abstract.domain">ExplicitValueDomain</option>
    <option name="--sifa.interference.applicator">POST_STATE</option>
    <option name="--sifa.location.tracking.mode">NONE</option>
    <option name="--sifa.location.abstraction">SINGLETON</option>
  </rundefinition>

  <rundefinition name="explicitvalue-guardedupdate-guard-lockset-publish">
    <option name="--sifa.abstract.domain">ExplicitValueDomain</option>
    <option name="--sifa.interference.applicator">GUARDED_EXACT_UPDATE</option>
  </rundefinition>

  <rundefinition name="explicitvalue-strongestpost-guard-lockset-publish">
    <option name="--sifa.abstract.domain">ExplicitValueDomain</option>
    <option name="--sifa.interference.applicator">STRONGEST_POSTCONDITION</option>
  </rundefinition>

  <rundefinition name="none-octagon-UNSOUND-timing-only">
    <option name="--sifa.abstract.domain">OctagonDomain</option>
    <option name="--sifa.interference.applicator">NONE</option>
    <option name="--sifa.max.parallel.octagon">2</option>
    <option name="--sifa.join.precision">false</option>
    <option name="--sifa.location.tracking.mode">NONE</option>
    <option name="--sifa.location.abstraction">SINGLETON</option>
  </rundefinition>

  <rundefinition name="octagon-poststate-guard-lockset-publish">
    <option name="--sifa.abstract.domain">OctagonDomain</option>
    <option name="--sifa.interference.applicator">POST_STATE</option>
    <option name="--sifa.location.tracking.mode">NONE</option>
    <option name="--sifa.location.abstraction">SINGLETON</option>
  </rundefinition>

  <rundefinition name="octagon-guardedupdate-guard-lockset-publish">
    <option name="--sifa.abstract.domain">OctagonDomain</option>
    <option name="--sifa.interference.applicator">GUARDED_EXACT_UPDATE</option>
  </rundefinition>

  <rundefinition name="octagon-strongestpost-guard-lockset-publish">
    <option name="--sifa.abstract.domain">OctagonDomain</option>
    <option name="--sifa.interference.applicator">STRONGEST_POSTCONDITION</option>
  </rundefinition>


  <tasks name="SVCOMP-Concurrency">
    <includesfile>../../../trunk/examples/svcomp/Concurrency.set</includesfile>
    <exclude>../../../trunk/examples/svcomp/pthread-wmm/*.yml</exclude>
    <propertyfile>../../../trunk/examples/svcomp/properties/no-overflow.prp</propertyfile>
  </tasks>
</benchmark>
