<?xml version="1.0" ?>
<!DOCTYPE table PUBLIC "+//IDN sosy-lab.org//DTD BenchExec table 1.10//EN" "https://www.sosy-lab.org/benchexec/table-1.10.dtd">
<table> 
  <column title="status"/>
  <column title="cputime"         displayTitle="CPU Time"/>
  <column title="walltime"        displayTitle="Wall Time"/>
  <column title="memory"          displayTitle="Memory" sourceUnit="B" displayUnit="MB"/>
  <column title="Iterations"      displayTitle="TAR Iterations">OverallIterations:\s*(\d+)</column>
  <column title="CheckTime"       displayTitle="Check Time" sourceUnit="s">ConditionalCommutativityCheckTime: (\d+(\.\d+)?)s</column>
  <column title="ConditionCalculationTime" displayTitle="Condition Calculation Time" sourceUnit="s">ConditionalCommutativityConditionCalculationTime: (\d+(\.\d+)?)s</column>
  <column title="CommutingCounterexamples" displayTitle="Commuting Counterexamples">ConditionalCommutativityCommutingCounterexamples:\s*(\d+)</column>
  <column title="ConditionCalculations" displayTitle="Condition Calculations">ConditionalCommutativityConditionCalculations:\s*(\d+)</column>
  <column title="TraceChecks" displayTitle="Trace Checks">ConditionalCommutativityTraceChecks:\s*(\d+)</column>
  <column title="UnknownTraceChecks" displayTitle="Unknown Trace Checks">ConditionalCommutativityUnknownTraceChecks:\s*(\d+)</column>
  <column title="ImperfectProofs" displayTitle="Imperfect Proofs">ConditionalCommutativityImperfectProofs:\s*(\d+)</column>
  <column title="QuantifiedConditions" displayTitle="Quantified Conditions">ConditionalCommutativityQuantifiedConditions:\s*(\d+)</column>
  <column title="FalseConditions" displayTitle="False Conditions">ConditionalCommutativityFalseConditions:\s*(\d+)</column>

  <union>
    <result filename="conditional-commutativity.*.results.NONE.*.xml" />
  </union>
  <union>
    <result filename="conditional-commutativity.*.results.CE-Sufficient.*.xml" />
  </union>
  <union>
    <result filename="conditional-commutativity.*.results.CE-SufficientWithContext.*.xml" />
  </union>
  <union>
    <result filename="conditional-commutativity.*.results.CE-NecessaryAndSufficient.*.xml" />
  </union>

</table>
