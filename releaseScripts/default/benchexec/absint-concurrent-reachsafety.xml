<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<benchmark tool="ultimateautomizer" memlimit="8GB" timelimit="90" hardtimelimit="90" cpuCores="2">
  <resultfiles></resultfiles>
  <option name="--force-no-wrapper" />
  <option name="-tc">${benchmark_path}/../../../trunk/examples/toolchains/AbstractInterpretationCInline.xml</option>
  <option name="-s">${benchmark_path}/../../../trunk/examples/settings/default/automizer/svcomp-Reach-32bit-Automizer_Default.epf</option>
  <option name="--abstractinterpretationv2.abstract.domain">OctagonDomain</option>
  <option name="--abstractinterpretationv2.abstract.domain.for.rcfg-of-the-future">PoormanAbstractDomain</option>
  <option name="--abstractinterpretationv2.use.the.rcfg-of-the-future.interface">true</option>
  <option name="--rcfgbuilder.future-live.optimization">false</option>

  <rundefinition name="singleton-nonrel">
    <option name="--abstractinterpretationv2.location.abstraction.method">"Non-relational Singleton"</option>
  </rundefinition>

  <rundefinition name="singleton-fast">
    <option name="--abstractinterpretationv2.location.abstraction.method">"Singleton, Fast Widening"</option>
  </rundefinition>

  <rundefinition name="singleton-slow">
    <option name="--abstractinterpretationv2.location.abstraction.method">"Singleton, Slow Widening"</option>
  </rundefinition>

  <rundefinition name="low-fast">
    <option name="--abstractinterpretationv2.location.abstraction.method">"Low Split, Fast Widening"</option>
  </rundefinition>

  <rundefinition name="low-slow">
    <option name="--abstractinterpretationv2.location.abstraction.method">"Low Split, Slow Widening"</option>
  </rundefinition>

  <rundefinition name="high-fast">
    <option name="--abstractinterpretationv2.location.abstraction.method">"High Split, Fast Widening"</option>
  </rundefinition>

  <rundefinition name="high-slow">
    <option name="--abstractinterpretationv2.location.abstraction.method">"High Split, Slow Widening"</option>
  </rundefinition>

  <tasks name="SVCOMP-Concurrency">
    <includesfile>${benchmark_path}/../../../trunk/examples/svcomp/Concurrency.set</includesfile>
    <!-- Exclude pthread-wmm to speedup evaluation -->
    <exclude>${benchmark_path}/../../../trunk/examples/svcomp/pthread-wmm/*.yml</exclude>
    <propertyfile>${benchmark_path}/../../../trunk/examples/svcomp/properties/unreach-call.prp</propertyfile>
  </tasks>
</benchmark>
